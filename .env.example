# Required for Docker deployment; generate with openssl rand -hex 32
PATEX_ACCESS_TOKEN=replace-with-long-random-token
PATEX_DATA_DIR=/data
PORT=3000
COMPILER_URL=http://compiler:3001
# Optional AI integration: Patex does not use your ChatGPT or Claude subscriptions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLAMAFARM_CHAT_URL=
LLAMAFARM_MODEL=
LLAMAFARM_API_KEY=
