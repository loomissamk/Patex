# Required for Docker deployment; generate with openssl rand -hex 32
PATEX_ACCESS_TOKEN=replace-with-long-random-token
PATEX_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
PATEX_DATA_DIR=/data
PORT=3000
COMPILER_URL=unix:/worker/worker.sock
# Set this to the socket directory printed by scripts/install-worker.sh
PATEX_WORKER_DIR=/home/your-user/.local/share/patex-worker/socket
PATEX_PUBLIC_URL=http://patex.sl
# Set true behind public HTTPS; false only for private HTTP over Tailscale
PATEX_COOKIE_SECURE=false
# Optional AI integration: Patex does not use your ChatGPT or Claude subscriptions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLAMAFARM_CHAT_URL=
LLAMAFARM_MODEL=
LLAMAFARM_API_KEY=
