FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production COMPILER_PORT=3001
ARG QUARTO_VERSION=1.11.7
ARG QUARTO_SHA256=27c57f25d4d03e46d65bb4b75ffd5bcf78cd04aad8dd0cd1f1f29fce72238cbf
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl python3 python3-dev python-is-python3 python3-numpy python3-scipy python3-pandas python3-matplotlib python3-sympy \
      r-base-core r-cran-knitr r-cran-rmarkdown r-cran-reticulate r-cran-codetools r-cran-here r-cran-ggplot2 r-cran-dplyr \
      latexmk biber texlive-xetex texlive-luatex texlive-publishers texlive-latex-base texlive-latex-recommended texlive-latex-extra fonts-lmodern lmodern && \
    curl -fsSL "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" -o /tmp/quarto.deb && \
    echo "${QUARTO_SHA256}  /tmp/quarto.deb" | sha256sum -c - && \
    apt-get install -y --no-install-recommends /tmp/quarto.deb && \
    rm -f /tmp/quarto.deb && rm -rf /var/lib/apt/lists/*
# Journal classes such as IEEEtran require the standard Times/PS font metrics.
RUN apt-get update && apt-get install -y --no-install-recommends texlive-fonts-recommended && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "dist/node/compiler/index.js"]
